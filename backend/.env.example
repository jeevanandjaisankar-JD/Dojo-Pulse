PORT=5000
MONGO_URI=mongodb://localhost:27017/dojo_pulse
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Google OAuth — use the same client ID in the frontend
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Frontend URL used for verification and password-reset links
FRONTEND_URL=http://localhost:5173

# Email delivery — configure using your SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. The backend automatically prefers data_processor/.venv when present.
PYTHON_CMD=python